{
  "name": "cachetta",
  "version": "0.3.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thekevinscott/cachetta.git",
    "directory": "packages/javascript"
  },
  "scripts": {
    "test:unit": "wireit",
    "test:unit:watch": "wireit",
    "test:integration": "wireit",
    "test:integration:watch": "wireit",
    "lint": "wireit",
    "typecheck": "wireit",
    "build": "wireit"
  },
  "wireit": {
    "lint": {
      "command": "eslint src",
      "files": [
        "./src/**/*.ts",
        "./eslint.config.js"
      ]
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "files": [
        "./src/**/*.ts",
        "./tsconfig.json"
      ]
    },
    "test:unit": {
      "command": "vitest run -c vitest.config.unit.ts"
    },
    "test:unit:watch": {
      "command": "vitest watch -c vitest.config.unit.ts"
    },
    "test:integration": {
      "command": "vitest run -c vitest.config.integration.ts",
      "dependencies": [
        "build"
      ]
    },
    "test:integration:watch": {
      "command": "vitest watch -c vitest.config.integration.ts",
      "dependencies": [
        "build"
      ]
    },
    "build": {
      "command": "vite build",
      "dependencies": [],
      "files": [
        "./src/**/*.ts",
        "./tsconfig.json",
        "./package.json",
        "./vite.config.ts"
      ],
      "output": [
        "dist"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.0",
    "cachetta": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.55.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.6",
    "wireit": "^0.14.9"
  }
}
